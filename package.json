{
  "name": "homepage",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "npm run prebuild && astro dev",
    "dev:all": "concurrently \"npm run dev\" \"cd admin && npm run dev\"",
    "start": "npm run prebuild && astro dev",
    "start:all": "concurrently \"npm run start\" \"cd admin && npm run start\"",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prebuild": "node build/prebuild",
    "fontmin": "node build/fontmin",
    "postbuild": "npm run fontmin && node build/postbuild",
    "sync:halo": "node scripts/sync-halo-articles.js"
  },
  "dependencies": {
    "@astrojs/check": "^0.7.0",
    "@astrojs/tailwind": "^5.1.0",
    "astro": "^4.11.5",
    "daisyui": "^2.6.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "fontmin": "^1.1.0",
    "terser": "^5.31.1",
    "vite-plugin-pwa": "^1.2.0"
  }
}
