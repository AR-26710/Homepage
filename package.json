{
  "name": "homepage",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm run prebuild && astro dev",
    "dev:all": "concurrently -n astro,editor -c blue,magenta \"pnpm run dev\" \"cd editor && pnpm run dev\"",
    "start": "pnpm run prebuild && astro dev",
    "start:all": "concurrently -n astro,editor -c blue,magenta \"pnpm run start\" \"cd editor && pnpm run start\"",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prebuild": "node build/prebuild",
    "fontmin": "node build/fontmin",
    "postbuild": "pnpm run fontmin && node build/postbuild",
    "sync:halo": "node scripts/syncHaloArticles.js",
    "sync:bilibili": "node scripts/updateBilibiliViews.js"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "astro": "^6.0.0",
    "autoprefixer": "^10.4.21",
    "daisyui": "^2.6.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "fontmin": "^1.1.0",
    "terser": "^5.31.1",
    "vite-plugin-pwa": "^1.2.0"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.8",
      "yaml": ">=2.8.3",
      "fast-xml-parser": ">=5.7.0",
      "@tootallnate/once": ">=3.0.1"
    }
  }
}
