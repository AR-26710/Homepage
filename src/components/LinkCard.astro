---
import type { Card2x1Props } from '../data/types';

interface Props {
  info: Card2x1Props;
}

const { info } = Astro.props;
---

<a href={info.url} target="_blank">
  <div
    class:list={[
      "card max-lg:card-compact rounded-xl flex justify-center shadow-xl shadow-accent w-full lg:w-[26rem] md:h-[4.25rem] lg:h-[5rem] mb-8",
      info.bgStyle,
    ]}
  >
    <div class="card-body justify-center">
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          {
            info.iconClass && (
              <div class:list={[info.iconClass, "w-8", "h-8", "mr-2"]} />
            )
          }
          <span
            class:list={[
              info.textStyle,
              "grow",
              "max-lg:text-sm",
              "text-xl",
              "whitespace-nowrap",
            ]}
          >
            {info.title}
          </span>
        </div>
        <span class={info.btnStyle}>{info.btnText}</span>
      </div>
    </div>
  </div>
</a>

<style>
  /* 小图标样式 */
  .jike, .coolapk, .sspai, .Steam, .mail_s, .QQ_s, .telegram_s, .twitter_s {
    background-image: url("/icons/icons.png");
    background-repeat: no-repeat;
    width: 32px;
    height: 32px;
  }
  
  /* 部分小图标需要覆盖背景尺寸 */
  .mail_s, .QQ_s, .telegram_s, .twitter_s {
    background-size: cover;
  }
  
  /* 图标位置 */
  .jike { background-position: -256px -0px; }
  .coolapk { background-position: -288px -0px; }
  .sspai { background-position: -320px -0px; }
  .Steam { background-position: -352px -0px; }
  .mail_s { background-position: -0px -0px; }
  .QQ_s { background-position: -32px -0px; }
  .telegram_s { background-position: -64px -0px; }
  .twitter_s { background-position: -96px -0px; }
</style>
