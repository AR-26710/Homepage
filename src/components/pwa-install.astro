---
const showInstallPrompt = false;
let deferredPrompt = null;
let isInstallable = false;
---

<div id="pwa-install-banner" class="hidden fixed bottom-4 left-4 right-4 md:left-auto md:right-4 md:w-96 bg-white dark:bg-gray-800 shadow-lg rounded-lg p-4 z-50 transition-all duration-300 transform translate-y-full opacity-0">
  <div class="flex items-start gap-3">
    <div class="flex-shrink-0">
      <img src="/favicons/android-chrome-192x192.png" alt="App Icon" class="w-12 h-12 rounded-lg">
    </div>
    <div class="flex-1">
      <h3 class="font-semibold text-gray-900 dark:text-white">安装呀哈喽</h3>
      <p class="text-sm text-gray-600 dark:text-gray-300 mt-1">将应用添加到主屏幕，获得更好的体验</p>
    </div>
    <button id="pwa-install-close" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
  <div class="mt-4 flex gap-2">
    <button id="pwa-install-btn" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition-colors">
      立即安装
    </button>
    <button id="pwa-install-later" class="flex-1 bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 font-medium py-2 px-4 rounded-lg transition-colors">
      稍后
    </button>
  </div>
</div>

<script>
  let deferredPrompt = null;
  let isInstallable = false;
  let dismissed = false;

  const banner = document.getElementById('pwa-install-banner');
  const installBtn = document.getElementById('pwa-install-btn');
  const closeBtn = document.getElementById('pwa-install-close');
  const laterBtn = document.getElementById('pwa-install-later');

  function showBanner() {
    if (!isInstallable || dismissed) return;
    banner.classList.remove('hidden');
    setTimeout(() => {
      banner.classList.remove('translate-y-full', 'opacity-0');
    }, 100);
  }

  function hideBanner() {
    banner.classList.add('translate-y-full', 'opacity-0');
    setTimeout(() => {
      banner.classList.add('hidden');
    }, 300);
  }

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    isInstallable = true;
    
    const dismissedTime = localStorage.getItem('pwa-install-dismissed');
    if (dismissedTime) {
      const daysSinceDismissed = (Date.now() - parseInt(dismissedTime)) / (1000 * 60 * 60 * 24);
      if (daysSinceDismissed < 7) {
        dismissed = true;
        return;
      }
    }
    
    setTimeout(showBanner, 3000);
  });

  window.addEventListener('appinstalled', () => {
    isInstallable = false;
    deferredPrompt = null;
    hideBanner();
    localStorage.removeItem('pwa-install-dismissed');
  });

  installBtn.addEventListener('click', async () => {
    if (!deferredPrompt) return;
    
    deferredPrompt.prompt();
    const { outcome } = await deferredPrompt.userChoice;
    
    if (outcome === 'accepted') {
      isInstallable = false;
      deferredPrompt = null;
    }
    
    hideBanner();
  });

  closeBtn.addEventListener('click', () => {
    dismissed = true;
    localStorage.setItem('pwa-install-dismissed', Date.now().toString());
    hideBanner();
  });

  laterBtn.addEventListener('click', () => {
    hideBanner();
  });
</script>

<style>
  #pwa-install-banner {
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  }
</style>
