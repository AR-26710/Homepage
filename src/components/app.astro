---
import { Image } from "astro:assets";
import LinkCard from "./LinkCard.astro";
import InfoCard from "./InfoCard.astro";
import ProjectCard from "./ProjectCard.astro";
import ImageCard from "./ImageCard.astro";
import SectionTitle from "./SectionTitle.astro";
import ArticlesList from "./ArticlesList.astro";
import info from "../data/info";
import beian from "../data/beian";

const cardOrder = info.cardVisibility.order || [
  'showTitleCard',
  'showBlogCard',
  'showPrimaryCards',
  'showArticlesSection',
  'showProjectsSection',
  'showDiarySection',
  'showMusicSection',
  'showPrimaryCardsMobile',
  'showContactSection',
];
---

<div class="container m-auto lg:max-xl:w-min main">
  <div
    class="xl:flex xl:flex-row xl:justify-between max-w-screen-2xl px-2 xs:px-5 lg:px-10"
  >
    <aside
      class="min-w-full md:min-w-0 xl:basis-1/3 xl:h-screen xl:sticky xl:top-0"
    >
      <div class="pt-10 xl:pt-20"></div>
      <div class="w-64">
        <Image
          class="w-32 h-32 md:w-52 md:h-52 rounded-full object-cover"
          src={info.imgUrl}
          alt={info.title}
          width={208}
          height={208}
          loading="eager"
        />
        <div class="pt-10"></div>
        <h1 class="text-4xl font-bold pl-2">{info.title}</h1>
        <p class="text-lg pl-2">{info.desc}</p>
        {info.lastUpdate && (
          <p class="text-sm pl-2 text-gray-500 mt-2">
            信息最后更新: {info.lastUpdate}
          </p>
        )}
      </div>
    </aside>

    <main>
      <div class="pt-10 xl:pt-20"></div>
      <div class="grid grid-cols-4 gap-x-4 lg:gap-x-8 lg:w-[54rem]">
        {cardOrder.map((key) => {
          // 检查卡片是否可见
          if (!info.cardVisibility[key]) return null;

          // 使用对象映射简化条件判断
          const renderCard = {
            showTitleCard: () => (
              <div class="col-span-4 md:col-span-2">
                <InfoCard info={info.titleCard} />
              </div>
            ),
            showBlogCard: () => (
              <div class="col-span-4 md:col-span-2">
                <InfoCard info={info.blogCard} />
              </div>
            ),
            showPrimaryCards: () => (
              <div class="hidden md:block col-span-2">
                {info.primaryCards.map((card) => (
                  <LinkCard info={card} />
                ))}
              </div>
            ),
            showArticlesSection: () => (
              <div class="col-span-4">
                <SectionTitle info={info.sectionTitles[0]} />
                <ArticlesList />
              </div>
            ),
            showProjectsSection: () => (
              <>
                <div class="col-span-4">
                  <SectionTitle info={info.sectionTitles[1]} />
                </div>
                <div class="col-span-4 md:col-span-2">
                  <InfoCard info={info.projectCardStart} />
                </div>
                {info.projectCards.map((card) => (
                  <div class="col-span-4 sm:col-span-2 md:col-span-1">
                    <ProjectCard info={card} />
                  </div>
                ))}
                <div class="col-span-4 md:col-span-2">
                  <InfoCard info={info.projectCardEnd} />
                </div>
              </>
            ),
            showDiarySection: () => (
              <>
                <div class="col-span-4">
                  <SectionTitle info={info.sectionTitles[2]} />
                </div>
                <div class="col-span-4 overflow-x-auto scrollbar-hide">
                  <div
                    class="flex flex-nowrap gap-4 pb-4 md:hidden snap-x snap-mandatory"
                    style="-webkit-overflow-scrolling: touch;"
                  >
                    {info.diaryCards.map((card) => (
                      <div class="flex-none w-[55%] snap-start">
                        <ImageCard info={card} />
                      </div>
                    ))}
                  </div>
                  <div class="hidden md:grid md:grid-cols-4 gap-x-4 lg:gap-x-8">
                    {info.diaryCards.map((card) => (
                      <div class="col-span-1">
                        <ImageCard info={card} />
                      </div>
                    ))}
                  </div>
                </div>
              </>
            ),
            showMusicSection: () => (
              <>
                <div class="col-span-4">
                  <SectionTitle info={info.sectionTitles[3]} />
                </div>
                {info.musicCards.map((card) => (
                  <div class="col-span-4 md:col-span-2">
                    <InfoCard info={card} />
                  </div>
                ))}
              </>
            ),
            showPrimaryCardsMobile: () => (
              <>
                <div class="md:hidden col-span-4">
                  <SectionTitle info={info.sectionTitles[4]} />
                </div>
                {info.primaryCards.map((card) => (
                  <div class="md:hidden sm:col-span-2 col-span-4">
                    <LinkCard info={card} />
                  </div>
                ))}
              </>
            ),
            showContactSection: () => (
              <>
                <div class="col-span-4">
                  <SectionTitle info={info.sectionTitles[5]} />
                </div>
                {info.teleCards.map((card) => (
                  <div class="col-span-4 md:col-span-2">
                    <LinkCard info={card} />
                  </div>
                ))}
              </>
            )
          };

          // 调用对应的渲染函数并添加 key
          return renderCard[key] ? <>{renderCard[key]()}</> : null;
        })}
      </div>

      <footer class="text-center py-10">
        <div class="">
          made with ❤️ by <a
            href="https://idealclover.top"
            target="_blank"
            class="text-gray-400">idealclover</a
          >
        </div>
        <div>
          🚀 powered by <a
            href="https://tailwindcss.com/"
            target="_blank"
            class="text-gray-400">tailwindcss</a
          >
          <a href="https://astro.build/" target="_blank" class="text-gray-400"
            >astro</a
          >
        </div>
        <div>
          💡 inspired by <a
            href="https://bento.me"
            target="_blank"
            class="text-gray-400">bento.me</a
          >
        </div>
        {
          beian.map((item) => (
            <div class="beian">
              <a
                href={item.url}
                rel="noreferrer"
                target="_blank"
                class="text-gray-400">{item.name}</a
              >
            </div>
          ))
        }
      </footer>
    </main>
  </div>
</div>

<style>
  /* 公共样式：大图标 */
  .icon-lg {
    background-image: url("/icons/icons.png");
    background-repeat: no-repeat;
    width: 64px;
    height: 64px;
  }
  
  /* 大图标位置 */
  .mail {
    background-position: -0px -0px;
  }
  .QQ {
    background-position: -64px -0px;
  }
  .telegram {
    background-position: -128px -0px;
  }
  .twitter {
    background-position: -192px -0px;
  }

  /* 隐藏滚动条但保留滚动功能 */
  .scrollbar-hide {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
  }
</style>

<script>
  // 更新粉丝数
  import updateInfo from "../data/update";

  document.addEventListener("DOMContentLoaded", () => {
    updateInfo.forEach((item) => {
      fetch(item.updateUrl)
        .then((response) => response.json())
        .then((data) => {
          const element = document.querySelector(`.${item.className}`);
          if (data.count == null) return;
          if (element) element.textContent = data.count + " Followers";
        })
        .catch((error) => console.error("Error:", error));
    });
  });
</script>
